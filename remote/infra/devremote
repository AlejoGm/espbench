#!/bin/bash
set -euo pipefail

# Siempre correr como sfypi — es el usuario dueño del tmux server y los procesos.
# Así devremote funciona igual desde systemd, SSH como sensipi, o cualquier usuario.
# (DEVREMOTE_NO_REEXEC: solo para tests.)
if [ "$(whoami)" != "sfypi" ] && [ -z "${DEVREMOTE_NO_REEXEC:-}" ]; then
  exec sudo -u sfypi "$0" "$@"
fi

PREFIX="esp32_"
BASE="${ESP_BASE:-/opt/esp}"
DEVDIR="${ESPBENCH_DEV_DIR:-/dev}"   # solo para tests

usage() {
  cat <<USAGE
Usage: devremote                      levanta las sesiones que falten
       devremote <dev>                se engancha a la sesión del device (tmux attach)
       devremote --status             tabla: device / puerto / estado
       devremote --reset [<dev>]      reinicia todas las sesiones, o la de <dev>
       devremote --unlock <dev>       libera el lock del device
       devremote --slots              ID_PATH de cada puerto, para armar slots.conf
       devremote --start <ttyUSBN>    levanta la sesión de un device (lo usa el hotplug)
       devremote --cleanup [--dry-run] [--jobs-days N] [--logs-days N]

<dev>: N (= ttyUSBN), ttyUSBN, esp-slotK o slotK
USAGE
  exit 1
}

list_devs() {
  ls -1 "$DEVDIR"/ttyUSB* 2>/dev/null || true
}

# Nombre y puerto: única fuente en espbench-name.
name_port() {
  espbench-name "$1"
}

# Argumento del operador → nombre del device.
resolve_name() {
  case "$1" in
    ''|*[!a-zA-Z0-9_-]*) echo "devremote: nombre de device inválido: '$1'" >&2; return 1 ;;
  esac
  if [[ "$1" =~ ^[0-9]+$ ]]; then
    echo "ttyUSB$1"
  elif [[ "$1" =~ ^slot[0-9]+$ ]]; then
    echo "esp-$1"
  else
    echo "$1"
  fi
}

start_one() {
  local dev="$1" name port
  read -r name port < <(name_port "$dev")
  if tmux has-session -t "${PREFIX}${name}" 2>/dev/null; then
    return 0
  fi
  esp32_tmux.sh "$dev"
}

scan_start_missing() {
  local dev
  while read -r dev; do
    [ -e "$dev" ] || continue
    start_one "$dev" || echo "devremote: no se pudo levantar $dev" >&2
  done < <(list_devs)
}

kill_name() {
  local name="$1"
  # El espacio final evita que ttyUSB1 también mate a ttyUSB10.
  sudo pkill -9 -f "python3.*remote_esp32[.]py -p ${DEVDIR}/${name} " 2>/dev/null || true
  sleep 1
  tmux kill-session -t "${PREFIX}${name}" 2>/dev/null || true
}

reset_all() {
  # Patrón "python3.*remote_esp32[.]py" evita matar el tmux server (cuyo cmdline
  # también contiene "remote_esp32.py") y evita que pkill se mate a sí mismo.
  sudo pkill -9 -f "python3.*remote_esp32[.]py" 2>/dev/null || true
  sleep 1

  tmux ls 2>/dev/null | awk -F: '{print $1}' | grep "^${PREFIX}" | while read -r s; do
    tmux kill-session -t "$s" || true
  done

  scan_start_missing
}

reset_one() {
  local name
  name="$(resolve_name "$1")"
  kill_name "$name"
  if [ ! -e "$DEVDIR/$name" ]; then
    echo "Advertencia: $DEVDIR/$name no existe, sesión no reiniciada" >&2
    return
  fi
  start_one "$DEVDIR/$name"
}

status() {
  local dev kname name port sess state pid fsm
  printf "%-12s  %-9s  %-6s  %-7s  %-12s  %s\n" "DEVICE" "KERNEL" "TCP" "SESION" "ESTADO" "PID"
  while read -r dev; do
    [ -e "$dev" ] || continue
    kname="$(basename "$dev")"
    read -r name port < <(name_port "$dev")
    sess="${PREFIX}${name}"

    if tmux has-session -t "$sess" 2>/dev/null; then
      pid="$(tmux list-panes -t "$sess" -F "#{pane_pid}" 2>/dev/null | head -n1 || true)"
      state="RUNNING"
    else
      pid="-"
      state="DOWN"
    fi
    # Estado de la FSM que publica el proceso (flashing, erasing, unknown...)
    fsm="$(grep -o '"state": "[a-z]*"' "$BASE/run/$name.json" 2>/dev/null | cut -d'"' -f4 || true)"

    printf "%-12s  %-9s  %-6s  %-7s  %-12s  %s\n" "$name" "$kname" "$port" "$state" "${fsm:--}" "$pid"
  done < <(list_devs)
}

attach_one() {
  local name sess
  name="$(resolve_name "$1")"
  sess="${PREFIX}${name}"
  if ! tmux has-session -t "$sess" 2>/dev/null; then
    echo "Error: sesión tmux '$sess' no existe" >&2
    exit 1
  fi
  exec tmux attach-session -t "$sess"
}

unlock_one() {
  local name lock_file user
  name="$(resolve_name "$1")"
  lock_file="$BASE/locks/$name"
  if [ -f "$lock_file" ]; then
    user="$(cut -d: -f1 "$lock_file")"
    rm -f "$lock_file"
    echo "Lock liberado (era de: $user) → $name"
  else
    echo "No había lock en $name"
  fi
}

slots() {
  local dev kname idp name port
  echo "slots.conf: $BASE/slots.conf  (una línea por puerto físico: \"<K> <ID_PATH>\")"
  echo ""
  printf "%-9s  %-12s  %-6s  %s\n" "KERNEL" "NOMBRE" "TCP" "ID_PATH"
  while read -r dev; do
    [ -e "$dev" ] || continue
    kname="$(basename "$dev")"
    idp="$(udevadm info -q property -n "$dev" 2>/dev/null | sed -n 's/^ID_PATH=//p')"
    read -r name port < <(name_port "$dev")
    printf "%-9s  %-12s  %-6s  %s\n" "$kname" "$name" "$port" "${idp:--}"
  done < <(list_devs)
  echo ""
  echo "Para fijar un slot: agregá \"<K> <ID_PATH>\" a slots.conf y después:"
  echo "  sudo udevadm trigger --subsystem-match=tty && devremote --reset"
}

cleanup() {
  local dry_run=0
  local jobs_days=7
  local logs_days=30
  local base="${ESP_BASE:-/opt/esp}"

  shift  # consumir "--cleanup"
  while [[ "${1:-}" == --* ]]; do
    case "$1" in
      --dry-run)    dry_run=1 ;;
      --jobs-days)  jobs_days="${2:?--jobs-days requiere valor}"; shift ;;
      --logs-days)  logs_days="${2:?--logs-days requiere valor}"; shift ;;
      *) echo "Opción desconocida: $1" >&2; exit 1 ;;
    esac
    shift
  done

  local removed_jobs=0 removed_days=0 freed=0

  echo "=== devremote cleanup ==="
  [ "$dry_run" = "1" ] && echo "(dry-run: no se borra nada)"
  echo "  jobs > ${jobs_days}d  →  ${base}/jobs/, ${base}/devices/*/jobs/"
  echo "  logs > ${logs_days}d  →  ${base}/logs/YYYYMMDD/, ${base}/devices/*/output_*.log"
  echo ""

  # Jobs dirs
  if [ -d "${base}/jobs" ]; then
    while IFS= read -r -d '' jobdir; do
      local size
      size=$(du -sh "$jobdir" 2>/dev/null | cut -f1)
      echo "  [job] $jobdir  ($size)"
      if [ "$dry_run" = "0" ]; then
        sudo rm -rf "$jobdir"
      fi
      removed_jobs=$((removed_jobs + 1))
    done < <(find "${base}/jobs" -mindepth 1 -maxdepth 1 -type d -mtime "+${jobs_days}" -print0)
  fi

  # Log day dirs
  if [ -d "${base}/logs" ]; then
    while IFS= read -r -d '' daydir; do
      local size
      size=$(du -sh "$daydir" 2>/dev/null | cut -f1)
      echo "  [log] $daydir  ($size)"
      if [ "$dry_run" = "0" ]; then
        sudo rm -rf "$daydir"
      fi
      removed_days=$((removed_days + 1))
    done < <(find "${base}/logs" -mindepth 2 -maxdepth 2 -type d -mtime "+${logs_days}" -print0)
  fi

  # Por device (devices/<mac>/): jobs y sesiones de log rotadas.
  # output.log (la sesión actual) nunca se toca.
  if [ -d "${base}/devices" ]; then
    while IFS= read -r -d '' jobdir; do
      echo "  [job] $jobdir  ($(du -sh "$jobdir" 2>/dev/null | cut -f1))"
      [ "$dry_run" = "0" ] && sudo rm -rf "$jobdir"
      removed_jobs=$((removed_jobs + 1))
    done < <(find "${base}/devices" -mindepth 3 -maxdepth 3 -path "*/jobs/*" -type d -mtime "+${jobs_days}" -print0)

    while IFS= read -r -d '' oldlog; do
      echo "  [log] $oldlog  ($(du -sh "$oldlog" 2>/dev/null | cut -f1))"
      [ "$dry_run" = "0" ] && sudo rm -f "$oldlog"
      removed_days=$((removed_days + 1))
    done < <(find "${base}/devices" -mindepth 2 -maxdepth 2 -name "output_*.log" -type f -mtime "+${logs_days}" -print0)
  fi

  echo ""
  if [ "$dry_run" = "1" ]; then
    echo "Encontrados: ${removed_jobs} job(s), ${removed_days} log(s) para borrar"
  else
    echo "Borrados: ${removed_jobs} job(s), ${removed_days} log(s)"
  fi
}

case "${1:-}" in
  --reset)   if [ -n "${2:-}" ]; then reset_one "$2"; else reset_all; fi ;;
  --status)  status ;;
  --unlock)  [ -n "${2:-}" ] || usage; unlock_one "$2" ;;
  --cleanup) cleanup "$@" ;;
  --start)   [ -n "${2:-}" ] || usage; start_one "$DEVDIR/$(basename "$2")" ;;
  --slots)   slots ;;
  "")        scan_start_missing ;;
  -*)        usage ;;
  *)         attach_one "$1" ;;
esac
